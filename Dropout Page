package com.example.school_dropoutscan

import android.content.Intent
import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.view.View
import android.widget.*
import androidx.appcompat.app.AppCompatActivity
import androidx.appcompat.widget.Toolbar

class DropoutActivity : AppCompatActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_dropout)

        val toolbar = findViewById<Toolbar>(R.id.toolbarDropout)
        val nameInput = findViewById<EditText>(R.id.nameInput)
        val registrationNumberInput = findViewById<EditText>(R.id.registrationNumberInput)
        val gradeInput = findViewById<EditText>(R.id.gradeInput)
        val feesPaidInput = findViewById<EditText>(R.id.feesPaidInput)
        val indisciplineCasesInput = findViewById<EditText>(R.id.indisciplineCasesInput)
        val scanButton = findViewById<Button>(R.id.scanButton)
        val progressBar = findViewById<ProgressBar>(R.id.progressBar)
        val progressText = findViewById<TextView>(R.id.progressText)

        setSupportActionBar(toolbar)

        findViewById<Button>(R.id.homeButton).setOnClickListener {
            startActivity(Intent(this, MainActivity::class.java))
        }

        findViewById<Button>(R.id.achievementsButton).setOnClickListener {
            startActivity(Intent(this, AchievementsActivity::class.java))
        }

        scanButton.setOnClickListener {
            val name = nameInput.text.toString()
            val registrationNumber = registrationNumberInput.text.toString()
            val grade = gradeInput.text.toString()
            val feesPaid = feesPaidInput.text.toString().toDoubleOrNull()
            val indisciplineCases = indisciplineCasesInput.text.toString().toIntOrNull()

            if (name.isEmpty() || registrationNumber.isEmpty() || grade.isEmpty() || feesPaid == null || indisciplineCases == null) {
                Toast.makeText(this, "Please fill in all the fields", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }

            // Show progress bar and reset progress
            progressBar.visibility = View.VISIBLE
            progressText.visibility = View.VISIBLE
            scanButton.isEnabled = false
            progressBar.progress = 0
            progressText.text = "0%"

            val handler = Handler(Looper.getMainLooper())
            var progress = 0

            val runnable = object : Runnable {
                override fun run() {
                    if (progress < 100) {
                        progress += 10
                        progressBar.progress = progress
                        progressText.text = "$progress%"
                        handler.postDelayed(this, 300)
                    } else {
                        progressBar.visibility = View.GONE
                        progressText.visibility = View.GONE
                        scanButton.isEnabled = true

                        val isDropout =
                            grade !in listOf("A", "B") || feesPaid < 50000 || indisciplineCases > 3
                        if (isDropout) {
                            val intent = Intent(
                                this@DropoutActivity,
                                DropoutResultActivity::class.java
                            ).apply {
                                putExtra("name", name)
                                putExtra("registrationNumber", registrationNumber)
                                putExtra("grade", grade)
                                putExtra("feesPaid", feesPaid)
                                putExtra("indisciplineCases", indisciplineCases)
                            }
                            startActivity(intent)
                        } else {
                            Toast.makeText(
                                this@DropoutActivity,
                                "The student is not a dropout.",
                                Toast.LENGTH_LONG
                            ).show()
                        }
                    }
                }
            }
            handler.post(runnable)
        }
    }
}

//XML FILE

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#BAA8F8">

    <!-- Toolbar for Dropout -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDropout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:title="Dropout"
        android:titleTextColor="@android:color/white"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar">

        <!-- Home Button -->
        <Button
            android:id="@+id/homeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textStyle="bold"
            android:textSize="18dp"
            android:textColor="@android:color/white"/>

        <!-- Achievements Button -->
        <Button
            android:id="@+id/achievementsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achievements"
            android:textStyle="bold"
            android:textSize="18dp"
            android:textColor="@android:color/white"/>

        <!-- Dropout Button -->
        <Button
            android:id="@+id/dropoutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dropout"
            android:textStyle="bold"
            android:textSize="18dp"
            android:textColor="@android:color/white"/>
    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Name Box -->
            <TextView
                android:id="@+id/nameLabel"
                android:text="Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Student Name"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp"/>

            <!-- Registration Number Box -->
            <TextView
                android:id="@+id/registrationNumberLabel"
                android:text="Registration Number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/registrationNumberInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Registration Number"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:inputType="text"
                android:layout_marginBottom="16dp"/>

            <!-- Grade Box -->
            <TextView
                android:id="@+id/gradeLabel"
                android:text="Grade (A, B, C, D)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/gradeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Grade"
                android:inputType="text"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Fees Paid Box -->
            <TextView
                android:id="@+id/feesPaidLabel"
                android:text="Fees Paid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/feesPaidInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Fees Paid"
                android:inputType="numberDecimal"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Indiscipline Cases Box -->
            <TextView
                android:id="@+id/indisciplineCasesLabel"
                android:text="Indiscipline Cases"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/indisciplineCasesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Indiscipline Cases"
                android:inputType="number"
                android:layout_marginBottom="16dp"/>

            <!-- Scan Button -->
            <Button
                android:id="@+id/scanButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"/>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="8dp"/>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/footer"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="?attr/colorPrimary"/>

    <!-- Content for Dropout -->

</LinearLayout>
