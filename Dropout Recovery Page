        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:gravity="left"
        android:text="1. Academic Counseling: Personalized guidance to help students understand their strengths, weaknesses, and career goals.\n\n
2. Financial Aid Support: Assistance in applying for scholarships, grants, or financial aid to ease economic burdens.\n\n
3. Extra Classes and Tutoring: Special remedial classes to improve academic performance in weak subjects.\n\n
4. Mentorship Programs: Connecting students with mentors who provide academic and career guidance.\n\n
5. Skill Development Courses: Training programs to equip students with practical skills for future careers.\n\n
6. Attendance Monitoring: Regular tracking of student attendance with interventions for frequent absences.\n\n
7. Parental Involvement: Engaging parents in discussions about their child’s education and progress.\n\n
8. Behavioral Counseling: Providing support to students struggling with discipline or emotional challenges.\n\n
9. Internship and Career Guidance: Helping students gain real-world experience and plan for future careers.\n\n
10. Flexible Learning Options: Offering evening classes, online courses, and alternative learning methods for students with unique needs."/>

    <TextView
        android:id="@+id/textView7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:gravity="center"
        android:textSize="20dp"
        android:layout_marginTop="30dp"
        android:text="Thank You" />

    <!-- Rating Bar Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rate the Recovery"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="20dp"
        android:layout_gravity="center_horizontal"/>

    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1.0"
        android:layout_gravity="center_horizontal"/>

</LinearLayout>
