package com.example.school_dropoutscan

import android.content.Intent
import android.os.Bundle
import android.widget.Button
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity
import androidx.appcompat.widget.Toolbar

class DropoutResultActivity : AppCompatActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_dropout_result)

        // Initialize the toolbar
        val toolbar = findViewById<Toolbar>(R.id.toolbarDropoutResult)
        setSupportActionBar(toolbar)

        // Home Button in Toolbar
        val homeButton = findViewById<Button>(R.id.homeButton)
        homeButton.setOnClickListener {
            val intent = Intent(this, MainActivity::class.java)
            startActivity(intent)
        }

        // Achievements Button in Toolbar (it should stay in this activity)
        val achievementsButton = findViewById<Button>(R.id.achievementsButton)
        achievementsButton.setOnClickListener {
            // This is already the Achievements Activity, so we can ignore this button
        }

        // Dropout Button in Toolbar
        val dropoutButton = findViewById<Button>(R.id.dropoutButton)
        dropoutButton.setOnClickListener {
            val intent = Intent(this, DropoutActivity::class.java)
            startActivity(intent)
        }

        // Retrieve data passed from DropoutActivity
        val name = intent.getStringExtra("name")
        val registrationNumber = intent.getStringExtra("registrationNumber")
        val grade = intent.getStringExtra("grade")
        val feesPaid = intent.getDoubleExtra("feesPaid", 0.0)
        val indisciplineCases = intent.getIntExtra("indisciplineCases", 0)

        // Set the result heading
        val resultHeading = findViewById<TextView>(R.id.resultHeading)
        resultHeading.text = "This student is a dropout student"

        // Display student details
        val studentName = findViewById<TextView>(R.id.studentName)
        studentName.text = "Name: $name"

        val studentRegistrationNumber = findViewById<TextView>(R.id.studentRegistrationNumber)
        studentRegistrationNumber.text = "Registration Number: $registrationNumber"

        val studentGrade = findViewById<TextView>(R.id.studentGrade)
        studentGrade.text = "Grade: $grade"

        val studentFeesPaid = findViewById<TextView>(R.id.studentFeesPaid)
        studentFeesPaid.text = "Fees Paid: ₹$feesPaid"

        val studentIndisciplineCases = findViewById<TextView>(R.id.studentIndisciplineCases)
        studentIndisciplineCases.text = "Indiscipline Cases: $indisciplineCases"

        // Display reasons why the student is a dropout
        val reasons = StringBuilder()

        if (grade !in listOf("A", "B")) {
            reasons.append("- Grade is below C\n")
        }
        if (feesPaid < 50000) {
            reasons.append("- Fees paid are less than 50,000\n")
        }
        if (indisciplineCases > 3) {
            reasons.append("- Number of indiscipline cases is greater than 3\n")
        }

        findViewById<Button>(R.id.dropoutRecoveryButton).setOnClickListener {
            val intent = Intent(this, DropoutRecoveryActivity::class.java)
            startActivity(intent)
        }

        // Set the reasons text (You can add a TextView in the layout for this purpose)
    }
}

//XML FILE

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#BAA8F8"
    tools:context=".DropoutResultActivity">

    <!-- Toolbar for Dropout Result -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDropoutResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:title="DropoutResult"
        android:titleTextColor="@android:color/white"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar">

        <!-- Home Button -->
        <Button
            android:id="@+id/homeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textStyle="bold"
            android:textSize="18dp"
            android:textColor="@android:color/white"/>

        <!-- Achievements Button -->
        <Button
            android:id="@+id/achievementsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Achievements"
            android:textStyle="bold"
            android:textSize="18dp"
            android:textColor="@android:color/white"/>

        <!-- Dropout Button -->
        <Button
            android:id="@+id/dropoutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dropout"
            android:textStyle="bold"
            android:textSize="18dp"
            android:textColor="@android:color/white"/>
    </androidx.appcompat.widget.Toolbar>
    <!-- Heading Text -->

    <TextView
        android:id="@+id/resultHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:text="This student is a dropout student"
        android:textAlignment="center"
        android:textSize="20dp"
        android:textStyle="bold" />

    <!-- Student Details -->
    <TextView
        android:id="@+id/studentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Name: "
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/studentRegistrationNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:text="Registration Number: "
        android:textSize="16sp" />

    <TextView
        android:id="@+id/studentGrade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Grade: "
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/studentFeesPaid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Fees Paid: "
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/studentIndisciplineCases"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:text="Indiscipline Cases: "
        android:textSize="16sp" />

    <Button
        android:id="@+id/dropoutRecoveryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginTop="70dp"
        android:text="Dropout Recovery" />
</LinearLayout>
