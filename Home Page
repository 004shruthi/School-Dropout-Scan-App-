package com.example.school_dropoutscan

import android.content.Intent
import android.os.Bundle
import android.widget.Button
import androidx.appcompat.app.AppCompatActivity
import androidx.appcompat.widget.Toolbar

class MainActivity : AppCompatActivity() {

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        // Initialize Toolbar
        val toolbar = findViewById<Toolbar>(R.id.toolbar)
        setSupportActionBar(toolbar)

        // Hide the title in the toolbar
        supportActionBar?.setDisplayShowTitleEnabled(false)

        // Initialize Home Button (although it won't need navigation as it's already Home)
        val homeButton: Button = findViewById(R.id.homeButton)
        homeButton.setOnClickListener {
            // This is already the Home Activity, no action needed
        }

        // Achievements Button Click
        val achievementsButton: Button = findViewById(R.id.achievementsButton)
        achievementsButton.setOnClickListener {
            val intent = Intent(this, AchievementsActivity::class.java)
            startActivity(intent)
        }

        // Dropout Button Click
        val dropoutButton: Button = findViewById(R.id.dropoutButton)
        dropoutButton.setOnClickListener {
            val intent = Intent(this, DropoutActivity::class.java)
            startActivity(intent)
        }
    }
}
